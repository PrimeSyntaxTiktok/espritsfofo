{
  "id": "./",
  "name": "Prime Sprites 1.2 — Collection Fortnite",
  "short_name": "Prime Sprites 1.2",
  "description": "Suis les 109 variantes d’esprits Fortnite sorties, consulte le guide et gère ta collection même hors connexion.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./#home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#07091a",
  "theme_color": "#07091a",
  "categories": ["games", "utilities"],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "./manifest.webmanifest"
    }
  ],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Catalogue",
      "short_name": "Catalogue",
      "description": "Ouvrir la collection des esprits",
      "url": "./#catalog",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Guide des capacités",
      "short_name": "Guide",
      "description": "Choisir un esprit selon son utilité",
      "url": "./#guide",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Réglages",
      "short_name": "Réglages",
      "description": "Personnaliser Prime Sprites 1.2",
      "url": "./#settings",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
